{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Prefect Server",
            "type": "debugpy",
            "request": "launch",
            "module": "prefect",
            "args": ["server", "start"],
            "env": {
                "PREFECT_API_URL": "http://127.0.0.1:4200/api",
                "CORTEX_ENV": "local"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Prefect Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "prefect",
            "args": ["worker", "start", "-p", "cortex-models", "--type", "process"],
            "env": {
                "PREFECT_API_URL": "http://127.0.0.1:4200/api",
                "CORTEX_ENV": "local"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            // "preLaunchTask": "Prefect: Start Server And Deployments"
        }
    ]
}
