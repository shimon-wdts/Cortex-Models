    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PREFECT_API_URL": "http://127.0.0.1:4200/api",
                "CORTEX_ENV": "local-env",
                "MLFLOW_TRACKING_INSECURE_TLS": "true",
                "MLFLOW_TRACKING_URI": "https://uat-mlflow-cortex-floor.wdts.local",
            }
        },
        {
            "name": "Python: Prefect Server",
            "type": "debugpy",
            "request": "launch",
            "module": "prefect",
            "args": ["server", "start"],
            "env": {
                "PREFECT_API_URL": "http://127.0.0.1:4200/api",
                "CORTEX_ENV": "local-env"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Prefect Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "prefect",
            "args": ["worker", "start", "-p", "cortex-models", "--type", "process"],
            "env": {
                "PREFECT_API_URL": "http://127.0.0.1:4200/api",
                "CORTEX_ENV": "local-env",
                // "CORTEX_MODEL_REGISTRY__KAFKA__BOOTSTRAP_SERVERS": "uat-kafka-bootstrap-cortex-floor.wdts.local:32100",
                // "CORTEX_MODEL_REGISTRY__KAFKA__SECURITY_PROTOCOL": "SASL_SSL",
                // "CORTEX_MODEL_REGISTRY__KAFKA__SASL_MECHANISM": "SCRAM-SHA-512",
                // "CORTEX_MODEL_REGISTRY__KAFKA__SASL_USERNAME": "model-inference",
                // "CORTEX_MODEL_REGISTRY__KAFKA__SASL_PASSWORD": "",
                // "CORTEX_MODEL_REGISTRY__KAFKA__SSL_CA_LOCATION": "/Users/shimonshrem/dev/WDTS/Cortex-Models/app/resources/ca.crt",
                // "CORTEX_MODEL_REGISTRY__KAFKA__SSL_ENDPOINT_IDENTIFICATION_ALGORITHM": "https"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            // "preLaunchTask": "Prefect: Start Server And Deployments"
        }
    ]
}
